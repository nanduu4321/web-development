<!DOCTYPE html>
<html>
<head>
    <title>Bakery and Cake Shop</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #fff5f5;
        }

        header {
            background: #8e354a;
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            background: #5c2333;
            text-align: center;
            padding: 12px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 15px;
        }

        h2 {
            text-align: center;
            color: #8e354a;
        }

        .offer {
            background: #ffe0e6;
            text-align: center;
            padding: 15px;
            margin: 20px;
            border-radius: 10px;
        }

        .products {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 20px;
        }

        .card {
            background: white;
            width: 200px;
            padding: 15px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 2px 6px #ccc;
        }

        .card img {
            width: 150px;
            height: 130px;
            object-fit: cover;
            border-radius: 8px;
        }

        .price {
            color: green;
            font-weight: bold;
        }

        button {
            background: #8e354a;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #5c2333;
        }

        footer {
            background: #5c2333;
            color: white;
            text-align: center;
            padding: 15px;
        }

        @media (max-width: 600px) {
            .products {
                flex-direction: column;
                align-items: center;
            }

            nav a {
                margin: 5px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Sweet Treats Bakery</h1>
        <p>Fresh Cakes, Pastries and Cookies</p>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#cakes">Products</a>
        <a href="#offers">Offers</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="offer" id="offers">
        <h2>Special Offer!</h2>
        <p>Get 20% off on selected cakes.</p>
    </div>

    <h2 id="cakes">Our Bakery Products</h2>

    <div class="products">

        <div class="card">
            <img src="https://placehold.co/150x130?text=Chocolate+Cake"
                 alt="Chocolate Cake">
            <h3>Chocolate Cake</h3>
            <p class="price">₹500</p>
            <p>Rich and delicious cake.</p>
            <button>Order Now</button>
        </div>

        <div class="card">
            <img src="https://placehold.co/150x130?text=Cupcakes"
                 alt="Cupcakes">
            <h3>Cupcakes</h3>
            <p class="price">₹150</p>
            <p>Soft and creamy cupcakes.</p>
            <button>Order Now</button>
        </div>

        <div class="card">
            <img src="https://placehold.co/150x130?text=Cookies"
                 alt="Cookies">
            <h3>Cookies</h3>
            <p class="price">₹100</p>
            <p>Fresh and crispy cookies.</p>
            <button>Order Now</button>
        </div>

        <div class="card">
            <img src="https://placehold.co/150x130?text=Pastries"
                 alt="Pastries">
            <h3>Pastries</h3>
            <p class="price">₹80</p>
            <p>Sweet and tasty pastries.</p>
            <button>Order Now</button>
        </div>

    </div>

    <footer id="contact">
        <h3>Contact Us</h3>
        <p>Email: sweettreats@example.com</p>
        <p>Address: Vijayawada, Andhra Pradesh</p>
        <p>© 2026 Sweet Treats Bakery</p>
    </footer>

</body>
</html>
